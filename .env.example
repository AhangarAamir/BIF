# Copy to .env. Model settings below only SEED data/settings.json on first start;
# after that, manage models in the UI (Models page) or edit data/settings.json.

# ---- Chat model: any OpenAI-compatible chat/completions endpoint (base URL up to /v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
# chat = /v1/chat/completions (agno OpenAILike) | responses = /v1/responses (agno OpenAIResponses)
LLM_API=chat
# none | minimal | low | medium | high | xhigh. "none" turns thinking off (much faster).
LLM_REASONING_EFFORT=
# Optional second profile, added when set. Always uses the Responses API.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=

# ---- Embeddings: any OpenAI-compatible /v1/embeddings endpoint
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=
EMBED_ENABLED=true

# ---- Corpus and storage
# Folder of PDFs / .txt / .md the agent answers from (relative to the project or absolute).
# To reuse aamir-rag's corpus: CORPUS_DIR=../aamir-rag/data/ril_data
CORPUS_DIR=data/corpus
# DATA_DIR=data

# ---- Citation links. Empty = open the local PDF at the cited page.
# RIL Document Center layout (same rules as aamir-rag):
# DOC_CENTER_BASE_URL=https://enp1.ril.com/sites/Regulatory/Document%20Center
# SITES_BASE_URL=https://enp1.ril.com

# ---- Server
HOST=127.0.0.1
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# When set, settings / ingest / delete endpoints need header X-Admin-Token.
ADMIN_TOKEN=

# ---- Retrieval / agent tuning
SEARCH_TOP_K=8
CHUNK_MAX_CHARS=2400
NUM_HISTORY_RUNS=4
TOOL_CALL_LIMIT=18
# One LLM call per document at ingest for title/parties/date/status (false = heuristics only)
INGEST_LLM_PROFILE=true
